@page "/passwordless/{handler?}"
@model Fido2Demo.PasswordLessModel
@{
    Layout = "_Layout.cshtml";
}

<div class="section">
    <div class="container">
        <h1 class="title is-1">Scenario: Passkey sign-in with a username</h1>
        <div class="content">
            <p>A username-first passkey flow: no password anywhere, but the Relying Party still asks for a username up front rather than letting the authenticator surface a discoverable credential on its own (see the usernameless scenario for that). User verification (PIN/biometrics) is optional here, set via <code>UserVerification</code>.</p>
            <p>Note: "passwordless" means no password is sent over the internet or stored in a database. A PIN or biometric might still be used locally, by the authenticator, to unlock the passkey.</p>
        </div>
        <div class="notification is-danger" id="notSupportedWarning" style="display:none">
            Please note: Your browser does not seem to support WebAuthn yet. <a href="https://caniuse.com/#search=webauthn" target="_blank">Supported browsers</a>
        </div>

        <div class="columns">
            <div class="column is-4">

                <h3 class="title is-3">Register user</h3>
                <form action="/passwordless" method="post" id="register">
                    <div class="field">
                        <label class="label">Username</label>
                        <div class="control has-icons-left has-icons-right">
                            <input class="input" type="text" placeholder="abergs" name="username" required>
                            <span class="icon is-small is-left">
                                <i class="fas fa-user"></i>
                            </span>
                        </div>
                    </div>

                    <div class="field">
                        <label class="label">Display name</label>
                        <div class="control has-icons-left has-icons-right">
                            <input class="input" type="text" placeholder="Anders Åberg" name="displayName">
                            <span class="icon is-small is-left">
                                <i class="fas fa-user"></i>
                            </span>
                        </div>
                    </div>

                    <div class="field">
                        <div class="control">
                            <button class="button is-link">Register user</button>
                        </div>
                    </div>
                </form>
            </div>
            <div class="column is-2"></div>
            <div class="column is-4">

                <h3 class="title is-3">Sign in</h3>
                <form action="/passwordless" method="post" id="signin">
                    <div class="field">
                        <label class="label">Username</label>
                        <div class="control has-icons-left has-icons-right">
                            <input class="input" type="text" placeholder="abergs" name="username" id="login-username" required>
                            <span class="icon is-small is-left">
                                <i class="fas fa-user"></i>
                            </span>
                        </div>
                    </div>

                    <div class="field">
                        <div class="control">
                            <button class="button is-link">Sign in</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="section">
    <div class="container">
        <div class="content">
            <h1 class="title is-2">Explanation: Passkey sign-in with FIDO2</h1>
            <p>
                In this scenario the passkey is looked up by username, rather than being discoverable on its own.
                The flow is visualized in the figure below.
            </p>
            <img src="~/images/scenario2.png" alt="figure visualizing username and challenge sent together with assertion" />
            <p>Setting <code>UserVerification</code> to required has the authenticator confirm the person via PIN or biometrics as part of unlocking the passkey &mdash; possession of the private key and verification of the person, in one gesture. Setting it to discouraged instead checks only user presence, minimizing the interaction needed to sign in.</p>

            <p>
                Read the source code for this demo here: <a href="@Url.ToGithub("Demo/wwwroot/js/passwordless.register.js")">passwordless.register.js</a> and <a href="@Url.ToGithub("Demo/wwwroot/js/passwordless.login.js")">passwordless.login.js</a> &mdash; these set the options that make this scenario what it is. The ceremony they run is shared by every scenario and lives in <a href="@Url.ToGithub("Demo/wwwroot/js/webauthn.js")">webauthn.js</a>.
            </p>
        </div>
    </div>
</div>

<script src="~/js/webauthn.js"></script>
<script src="~/js/passwordless.register.js"></script>
<script src="~/js/passwordless.login.js"></script>